{
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run content:validate && npm test",
    "prebuild": "npm run content:validate",
    "content:validate": "node scripts/validate-content.mjs",
    "codegen:blog": "node scripts/codegen/generate.mjs blog",
    "codegen:speaker": "node scripts/codegen/generate.mjs speaking",
    "test:http": "node scripts/smoke.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "gray-matter": "~4.0.3",
    "next": "~16.4.3",
    "next-mdx-remote": "^6.0.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-markdown": "~10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "~4.3.3",
    "@types/node": "~26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "~4.3.3",
    "typescript": "~6.0.0"
  }
